; 16 matmul_cached — the same matrix multiply, on a GPU with a 16-line cache
; -----------------------------------------------------------------------------
; Identical instructions to 07_matmul. The only change is .cache 16: a small
; direct-mapped cache (rtl/ps_cache.v) sits between the memory arbiter and
; DRAM. Every row of A and column of B is read by many threads, so most loads
; hit the cache and never reach DRAM. Compare the cycle counts:
;     ./pixelstorm rtl matmul          ./pixelstorm rtl matmul_cached
; A streaming kernel (13_gradient_shader) gets slightly slower with the same
; cache: with no reuse, every access pays for the extra hop. That trade-off is
; why real GPUs let programs choose how to use their caches.
; =============================================================================
.kernel matmul_cached
.cache 16                      ; <- the only difference from 07_matmul
.grid 2
.block 32
.equ A, 0x000
.equ B, 0x040
.equ C, 0x080
.param 0, A
.param 1, B
.param 2, C
.seq  A, 64, 1, 1              ; A = 1..64 row-major
.seq  B, 64, 0, 1              ; B = 0..63 row-major
.dump C, 64, C = A x B (8x8)

    S2R   R0, CTAID
    S2R   R1, NTID
    S2R   R2, TID
    MAD   R3, R0, R1, R2        ; i
    SHRI  R4, R3, 3             ; row
    ANDI  R5, R3, 7             ; col
    LDC   R6, c[0]
    SHLI  R7, R4, 3
    ADD   R6, R6, R7            ; &A[row][0]
    LDC   R7, c[1]
    ADD   R7, R7, R5            ; &B[0][col]
    MOVI  R8, 0                 ; acc
    MOVI  R9, 0                 ; k
    MOVI  R13, 8
kloop:
    LDG   R10, [R6]             ; A[row][k]
    LDG   R11, [R7]             ; B[k][col]
    MAD   R8, R10, R11, R8      ; acc += a * b
    ADDI  R6, R6, 1
    ADDI  R7, R7, 8
    ADDI  R9, R9, 1
    SETP.LT P0, R9, R13
@P0 BRA   kloop
    LDC   R12, c[2]
    ADD   R12, R12, R3
    STG   [R12], R8
    EXIT
