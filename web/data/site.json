,"cuda":"PTX add.s32 r, r, imm"},{"name":"MULI","group":"alu","cuda":"PTX mul.lo.s32 r, r, imm"},{"name":"ANDI","group":"alu","cuda":"PTX and.b32 r, r, imm"},{"name":"ORI","group":"alu","cuda":"PTX or.b32 r, r, imm"},{"name":"XORI","group":"alu","cuda":"PTX xor.b32 r, r, imm"},{"name":"SHLI","group":"alu","cuda":"PTX shl.b32 r, r, imm"},{"name":"SHRI","group":"alu","cuda":"PTX shr.u32 r, r, imm"},{"name":"SRAI","group":"alu","cuda":"PTX shr.s32 r, r, imm"},{"name":"SETP","group":"predicate","cuda":"PTX setp.lt.s32; SASS ISETP"},{"name":"VOTE","group":"warp","cuda":"__any_sync / __all_sync / __ballot_sync; SASS VOTE"},{"name":"SHFL","group":"warp","cuda":"__shfl_sync / __shfl_down_sync / __shfl_xor_sync; SASS SHFL"},{"name":"LDG","group":"memory","cuda":"PTX ld.global; SASS LDG"},{"name":"STG","group":"memory","cuda":"PTX st.global; SASS STG"},{"name":"LDS","group":"memory","cuda":"__shared__ read; PTX ld.shared; SASS LDS"},{"name":"STS","group":"memory","cuda":"__shared__ write; PTX st.shared; SASS STS"},{"name":"ATOM","group":"memory","cuda":"atomicAdd(); PTX atom.global.add; SASS ATOMG / RED"},{"name":"ATOMS","group":"memory","cuda":"atomicAdd on __shared__; PTX atom.shared.add; SASS ATOMS"}],"rtl":"    // -------------------------------------------------------------------------\n    // Warp status + scheduler (combinational)\n    // -------------------------------------------------------------------------\n    reg  [NUM_WARPS-1:0]         w_done;\n    reg  [NUM_WARPS*IMEM_AW-1:0] w_minpc;\n    integer i, j, k;\n    always @* begin\n        for (i = 0; i < NUM_WARPS; i = i + 1) begin\n            w_done[i] = 1'b1;\n            w_minpc[i*IMEM_AW +: IMEM_AW] = {IMEM_AW{1'b1}};\n            for (j = 0; j < WARP_SIZE; j = j + 1) begin\n                if (!ldone[i*WARP_SIZE+j]) begin\n                    w_done[i] = 1'b0;\n                    if (lpc[(i*WARP_SIZE+j)*IMEM_AW +: IMEM_AW] < w_minpc[i*IMEM_AW +: IMEM_AW])\n                        w_minpc[i*IMEM_AW +: IMEM_AW] = lpc[(i*WARP_SIZE+j)*IMEM_AW +: IMEM_AW];\n                end\n            end\n        end\n    end\n\n    wire [NUM_WARPS-1:0] live     = w_valid & ~w_done;\n    wire [NUM_WARPS-1:0] eligible = live & ~w_wait;\n    wire                 bar_release = (|(live & w_wait)) && ((live & ~w_wait) == {NUM_WARPS{1'b0}});\n\n    reg            found;\n    reg [WW-1:0]   pick;\n    reg [WARP_SIZE-1:0] pick_act;\n    always @* begin\n        found = 1'b0;\n        pick  = {WW{1'b0}};\n        for (i = 0; i < NUM_WARPS; i = i + 1) begin\n            k = (rr_ptr + i) % NUM_WARPS;\n            if (!found && eligible[k]) begin\n                found = 1'b1;\n                pick  = k[WW-1:0];\n            end\n        end\n        for (j = 0; j < WARP_SIZE; j = j + 1)\n            pick_act[j] = !ldone[pick*WARP_SIZE+j] &&\n                          (lpc[(pick*WARP_SIZE+j)*IMEM_AW +: IMEM_AW] == w_minpc[pick*IMEM_AW +: IMEM_AW]);\n    end\n\n    // -------------------------------------------------------------------------"}